# Copy these variable names into .env.local for local development.
# Never put a real secret in this example file or any VITE_* variable.
GEMINI_API_KEY="replace-with-your-secret-key"
GEMINI_MODEL="model of gemini"
AI_TIMEOUT_MS=your_timeout_in_milliseconds
APP_URL="your app url"

# Firebase Console > Project settings > General > Your apps > Web app config.
# These four values are public web configuration, served by Express at runtime.
FIREBASE_API_KEY=""
FIREBASE_AUTH_DOMAIN=""
FIREBASE_PROJECT_ID=""
FIREBASE_APP_ID=""
# Exact origin visited in the browser; use your HTTPS domain in production.
AUTH_ORIGIN="http://localhost:3000"
# Independent random secret, at least 32 characters. Keep stable across restarts.
AUTH_SESSION_SECRET=""

# Server-only Turso connection. After configuring, run npm run db:setup once.
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""
# Enable Google in Firebase Authentication and add localhost to Authorized domains.
# GOOGLE_CLIENT_ID/SECRET are not used. GOOGLE_AUTH_ORIGIN remains a legacy alias.

AI_DAILY_CHAT_LIMIT="5"
AI_DAILY_PRONUNCIATION_LIMIT="10"
AI_DAILY_QUIZ_LIMIT="2"

# Optional iframe allowlist; same-origin only when omitted.
# ALLOWED_FRAME_ANCESTORS="'self' https://your-main-site.example"

# GOOGLE ADSENSE: Your Google AdSense Publisher ID (e.g., ca-pub-1234567890123456)
# You can also configure this directly in the app via the AdSense Settings panel.
VITE_ADSENSE_CLIENT_ID=""
VITE_ADSENSE_SLOT_BANNER=""
VITE_ADSENSE_SLOT_REWARDED=""

# The settings UI is available only in Vite development mode.
VITE_ENABLE_ADMIN_TOOLS="false"

